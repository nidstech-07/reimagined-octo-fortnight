def attendance_menu(cursor, connection):
    while True:
        print("\n=== ATTENDANCE MANAGEMENT ===")
        print("1. Add attendance\n2. Display all attendance\n3. Find by student ID")
        print("4. Update attendance status\n5. Delete attendance record\n6. Back")
        choice = input("Choose: ").strip()
        try:
            if choice == "1":
                student_id = int(input("Student ID: "))
                roll_no = input("Roll number: ").strip()
                name = input("Student name: ").strip()
                date = input("Attendance date (YYYY-MM-DD): ").strip()
                class_name = input("Class: ").strip()
                section = input("Section: ").strip()
                status = input("Present or absent (P/A): ").strip().upper()
                if status not in ("P", "A"):
                    print("Status must be P or A.")
                    continue
                cursor.execute("""
                    INSERT INTO attendance
                    (student_id, roll_no, name, doa, class_name, section, status)
                    VALUES (%s, %s, %s, %s, %s, %s, %s)
                """, (student_id, roll_no, name, date, class_name, section, status))
                connection.commit()
                print("Attendance added.")
            elif choice == "2":
                view_records(cursor, "attendance")
            elif choice == "3":
                view_records(cursor, "attendance", True)
            elif choice == "4":
                student_id = int(input("Student ID: "))
                date = input("Attendance date (YYYY-MM-DD): ").strip()
                status = input("New status (P/A): ").strip().upper()
                if status not in ("P", "A"):
                    print("Status must be P or A.")
                    continue
                cursor.execute(
                    "UPDATE attendance SET status = %s WHERE student_id = %s AND doa = %s",
                    (status, student_id, date),
                )
                connection.commit()
                print("Attendance updated." if cursor.rowcount else "Record not found.")
            elif choice == "5":
                student_id = int(input("Student ID: "))
                date = input("Attendance date (YYYY-MM-DD): ").strip()
                cursor.execute(
                    "DELETE FROM attendance WHERE student_id = %s AND doa = %s",
                    (student_id, date),
                )
                connection.commit()
                print("Attendance deleted." if cursor.rowcount else "Record not found.")
            elif choice == "6":
                break
            else:
                print("Invalid choice.")
        except (ValueError, Error) as exc:
            connection.rollback()
            print(f"Operation failed: {exc}")


