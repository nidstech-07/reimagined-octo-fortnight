        ("director", "dir2025", "admin"),
        ("teacher1", "teach123", "teacher"),
        ("teacher2", "teach456", "teacher"),
        ("math_teacher", "math2025", "teacher"),
        ("science_teacher", "sci2025", "teacher"),
        ("english_teacher", "eng2025", "teacher"),
        ("student1", "stud123", "student"),
        ("student2", "stud456", "student"),
        ("nidhi", "pass2025", "student"),
        ("rohan", "rohan2025", "student"),
        ("aisha", "aisha2025", "student"),
    ]
    for record in login_data:
        cursor.execute("""
            INSERT IGNORE INTO login (username, password, role)
            VALUES (%s, %s, %s)
        """, record)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS students (
            student_id INT PRIMARY KEY,
            roll_no VARCHAR(20),
            name VARCHAR(100),
            gender VARCHAR(10),
            dob DATE,
            class_name VARCHAR(20),
            section VARCHAR(10),
            adm_yr YEAR,
            email VARCHAR(100),
            guardian_name VARCHAR(100),
            contact_no VARCHAR(15)
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS academics (
            student_id INT PRIMARY KEY,
            name VARCHAR(100),
            class_name VARCHAR(20),
            exam_name VARCHAR(50),
            physics INT,
            chemistry INT,
            math INT,
            english INT,
            computer INT,
            percentage FLOAT
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS attendance (
            attendance_id INT AUTO_INCREMENT PRIMARY KEY,
            student_id INT NOT NULL,
            roll_no VARCHAR(20),
            name VARCHAR(100),
            doa DATE,
            class_name VARCHAR(20),
            section VARCHAR(10),
            status CHAR(1),
            UNIQUE KEY unique_student_attendance (student_id, doa)
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS fee (
            fee_id INT AUTO_INCREMENT PRIMARY KEY,
            name VARCHAR(100) NOT NULL,
            class_name VARCHAR(20),
            amount_paid DECIMAL(10, 2) NOT NULL,
            payment_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS schedule (
            club VARCHAR(30) PRIMARY KEY,
            event_date DATE
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS register (
            registration_id INT AUTO_INCREMENT PRIMARY KEY,
            club_name VARCHAR(30),
            student_name VARCHAR(100),
            class_name VARCHAR(20),
            UNIQUE KEY unique_club_registration (club_name, student_name)
        )
    """)
    connection.commit()


def login_user(cursor):
    print("\n=== LOGIN ===")
    username = input("Username: ").strip()
    password = input("Password: ").strip()
    cursor.execute(
        "SELECT username, role FROM login WHERE username = %s AND password = %s",
        (username, password),
    )
    user = cursor.fetchone()
    if user:
        print(f"\nLogin successful. Welcome, {user[0]}! Role: {user[1]}\n")
        return user
    print("\nLogin unsuccessful. Invalid username or password.\n")
    return None


def add_student(cursor, connection):
    try:
        values = (
            int(input("Student ID: ")),
            input("Roll number: ").strip(),
            input("Name: ").strip(),
            input("Gender: ").strip(),
            input("Date of birth (YYYY-MM-DD): ").strip() or None,
            input("Class: ").strip(),
            input("Section: ").strip(),
            input("Admission year (YYYY): ").strip() or None,
            input("Email: ").strip(),
            input("Guardian name: ").strip(),
            input("Contact number: ").strip(),
        )
        cursor.execute("""
            INSERT INTO students
            (student_id, roll_no, name, gender, dob, class_name, section,
             adm_yr, email, guardian_name, contact_no)
            VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
        """, values)
        connection.commit()
        print("Student added successfully.")
    except (ValueError, Error) as exc:
        connection.rollback()
        print(f"Could not add student: {exc}")


def view_records(cursor, table, where_id=False):
    if where_id:
        try:
            student_id = int(input("Enter student ID: "))
        except ValueError:
            print("Student ID must be a number.")
            return
        cursor.execute(f"SELECT * FROM {table} WHERE student_id = %s", (student_id,))
    else:
        cursor.execute(f"SELECT * FROM {table}")
    rows = cursor.fetchall()
    if not rows:
        print("No records found.")
        return
    for row in rows:
        print(row)


