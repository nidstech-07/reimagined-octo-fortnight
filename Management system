def connect_database():
    """Create the database if needed, then connect to it."""
    connection = mysql.connector.connect(**DB_CONFIG)
    cursor = connection.cursor()
    cursor.execute("CREATE DATABASE IF NOT EXISTS student_management")
    cursor.close()
    connection.close()

    config = {**DB_CONFIG, "database": "student_management"}
    return mysql.connector.connect(**config)


def setup_tables(cursor, connection):
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS login (
            username VARCHAR(50) NOT NULL UNIQUE,
            password VARCHAR(100) NOT NULL,
            role VARCHAR(20) NOT NULL
        )
    """)

    # Demo accounts from the supplied program. Change these before real use.
    login_data = [
        ("admin1", "admin123", "admin"),
        ("principal", "headadmin", "admin"),
        ("system_admin", "sys@2025", "admin"),
